# {{ ansible_managed }}
# OpenVPN client configuration — type: mobile (iPhone/Tunnelblick)
# Client: {{ item.name }}
# Full tunnel — default route via VPN

client
dev tun
proto {{ openvpn_remote_proto }}-client
remote {{ openvpn_remote }} {{ openvpn_remote_port }}
topology {{ openvpn_topology }}

# Redirect ALL traffic through the VPN
# (redirect-gateway покрывает только IPv4; block-ipv6 глушит IPv6-утечку —
# весь трафик мобильного клиента идёт через VPN по IPv4)
redirect-gateway def1 bypass-dhcp
block-ipv6

# DNS servers pushed by server
{% for dns in openvpn_dns_servers %}
dhcp-option DNS {{ dns }}
{% endfor %}
{% if openvpn_search_domain | default('') %}
dhcp-option DOMAIN {{ openvpn_search_domain }}
{% endif %}

# Block DNS leaks (prevents OS from using local DNS while tunnel is up)
block-outside-dns

# Keep trying to connect
resolv-retry infinite
nobind
persist-key
persist-tun

# Crypto
data-ciphers {{ openvpn_cipher }}
cipher {{ openvpn_cipher }}
auth {{ openvpn_auth }}

# TLS auth
key-direction 1
<tls-auth>
{{ openvpn_ta_key_b64.content | b64decode }}
</tls-auth>

# Certificates
<ca>
{{ openvpn_ca_cert_b64.content | b64decode }}
</ca>
<cert>
{{ (openvpn_client_certs_b64.results | selectattr('item.name', 'equalto', item.name) | map(attribute='content') | first | b64decode) | regex_replace('(?s).*?(-----BEGIN CERTIFICATE-----.*?-----END CERTIFICATE-----).*', '\\1') }}
</cert>
<key>
{{ openvpn_client_keys_b64.results | selectattr('item.name', 'equalto', item.name) | map(attribute='content') | first | b64decode }}
</key>

# Connection settings
verb 3
mute 20
