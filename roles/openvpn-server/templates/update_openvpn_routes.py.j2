#!/usr/bin/env python3
# {{ ansible_managed }}
"""Обновление routes.inc для OpenVPN из внешних источников.

Источники:
  1. Сервисы с {{ openvpn_iplist_base_url }} (openvpn_iplist_services):
      скачиваются батчами по {{ openvpn_iplist_batch_size }} сервисов за запрос.
      Берутся CIDRv4-зоны; отдельные ip4-адреса — только если
      openvpn_iplist_include_ip4=true (у крупных сервисов их десятки тысяч).
      При openvpn_ipv6_enabled также берутся cidr6 (и ip6 при
      openvpn_iplist_include_ip6=true) — как push "route-ipv6 ...".
      Упавший батч пропускается с warning — остальные обновляются.
  2. {{ openvpn_antifilter_url }} — список сетей в CIDR (223.130.134.0/24)
     (отключается через openvpn_antifilter_enabled)
  3. {{ openvpn_routes_custom_list }} — пополняемый админом список:
      - сети в формате IP/NETMASK  (149.154.164.0/255.255.252.0)
      - сети в формате CIDR        (149.154.164.0/22, 2a00:1450:4000::/37)
      - имена хостов               (apps.apple.com — резолвятся в IPv4)
  4. Российские сети ({{ openvpn_russia_exclude_base_url }}) — российский
      трафик никогда не должен ходить через VPN. Источники — порталы из
      openvpn_russia_exclude_portals (запрашиваются батчами, как сервисы);
      пустой список = российские исключения отключены:
      - из VPN-маршрутов российские части вырезаются (cut_russian_v4):
        точное совпадение — сеть не пушится вовсе; российская строго внутри
        VPN — сеть режется на префиксы без российской части (address_exclude);
        VPN строго внутри российской — пушится как есть (у неё префикс
        длиннее, остальная часть российской пойдёт по дефолту);
      - сами российские сети пушатся через net_gateway в отдельный файл
        routes-ru.inc — он включается только в CCD mobile-клиентов
        (redirect-gateway захватывает весь v4-трафик). Роутеры его не
        получают: у них default route и так через провайдера, а Keenetic
        не умеет net_gateway. Вырезать эти пуши через push-remove
        net_gateway из CCD нельзя: OpenVPN матчит push-remove по префиксу,
        а не по подстроке (push.c: strncmp(e->option, p, strlen(p))) —
        "route ... net_gateway" под "net_gateway" не подпадает;
      - IPv6 фильтруется: route-ipv6 на tun не умеет net_gateway, поэтому
        v6-сети, пересекающиеся с российским списком, не пушатся вовсе.
      Ошибка загрузки прерывает обновление.

Российские части вырезаются ДО агрегации, по каждой сети отдельно
(сервисной, antifilter или кастомной): при агрегации узкая сеть исчезает
внутри более широкой и молча делит её судьбу при вырезании (95.100.48.0/20
viber.com внутри 95.100.0.0/15 facebook.com, совпадающей с российской).
После вырезания сети агрегируются (ipaddress.collapse_addresses):
вложенные и смежные схлопываются (например, /32 внутри /23 исчезает,
два смежных /24 сливаются в /23). Суперсеть собирается только из полного
набора детей, поэтому агрегация никогда не захватывает лишние адреса.
Пересечения российских сетей с VPN-сетями (все случаи) логируются в stderr.

Формат routes.inc:    push "route <network> <netmask> vpn_gateway"
                     push "route-ipv6 <cidr>"
Формат routes-ru.inc: push "route <network> <netmask> net_gateway"
Если любой из файлов изменился — рестарт openvpn@{{ openvpn_server_name }}.
"""

import bisect
import ipaddress
import json
import os
import socket
import subprocess
import sys
import tempfile
import urllib.parse
import urllib.request

ROUTES_INC = "{{ openvpn_routes_inc }}"
ROUTES_RU_INC = "{{ openvpn_routes_ru_inc }}"
CUSTOM_LIST = "{{ openvpn_routes_custom_list }}"
ANTIFILTER_URL = "{{ openvpn_antifilter_url }}"
ANTIFILTER_ENABLED = {{ 'True' if openvpn_antifilter_enabled else 'False' }}
IPLIST_BASE_URL = "{{ openvpn_iplist_base_url }}"
IPLIST_SERVICES = [{% for s in openvpn_iplist_services %}"{{ s }}"{% if not loop.last %}, {% endif %}{% endfor %}]
IPLIST_BATCH_SIZE = {{ openvpn_iplist_batch_size }}
IPLIST_INCLUDE_IP4 = {{ 'True' if openvpn_iplist_include_ip4 else 'False' }}
IPLIST_INCLUDE_IP6 = {{ 'True' if openvpn_iplist_include_ip6 else 'False' }}
IPV6_ENABLED = {{ 'True' if openvpn_ipv6_enabled else 'False' }}
RUSSIA_BASE_URL = "{{ openvpn_russia_exclude_base_url }}"
RUSSIA_PORTALS = [{% for p in openvpn_russia_exclude_portals %}"{{ p }}"{% if not loop.last %}, {% endif %}{% endfor %}]
RUSSIA_EXCLUDE_ENABLED = {{ 'True' if openvpn_russia_exclude_enabled else 'False' }}
OPENVPN_SERVICE = "openvpn@{{ openvpn_server_name }}"

# Сети, направляемые в VPN
VPN_V4_NETWORKS = set()
VPN_V6_NETWORKS = set()
# Источники VPN v4-сетей (для логов: сервис/antifilter/custom)
VPN_V4_SOURCES = {}
# Российские IPv4-сети (net_gateway — через исходный шлюз клиента)
RU_V4_NETWORKS = set()
# Российские порталы по сетям (для логов)
RU_V4_PORTALS = {}
# Индекс российских сетей для вырезания: схлопнутые (collapse) сети,
# отсортированные по началу — поиск бисекцией за O(log n)
RU_SORTED = []
RU_STARTS = []
RU_COLLAPSED = set()
# Российские IPv6-сети (фильтр для v6-маршрутов)
RUSSIA_V6_NETWORKS = set()


def add_v4(net, gateway="vpn_gateway", source=""):
    """Добавить IPv4-сеть в набор (vpn_gateway или net_gateway)."""
    if gateway == "vpn_gateway":
        VPN_V4_NETWORKS.add(net)
        if source:
            VPN_V4_SOURCES.setdefault(net, source)
    else:
        RU_V4_NETWORKS.add(net)


def fmt_vpn(net):
    """Сеть с источником для логов (если известен)."""
    src = VPN_V4_SOURCES.get(net)
    return f"{net.with_prefixlen} ({src})" if src else net.with_prefixlen


def fmt_ru(net):
    """Российская сеть с порталами-источниками для логов (если известны)."""
    portals = RU_V4_PORTALS.get(net)
    if not portals:
        return net.with_prefixlen
    shown = ", ".join(sorted(portals)[:3])
    more = f" и ещё {len(portals) - 3}" if len(portals) > 3 else ""
    return f"{net.with_prefixlen} ({shown}{more})"


def add_v6(net, source=""):
    """Добавить IPv6-сеть в набор; False — если пересекается с российской.

    route-ipv6 на tun не умеет net_gateway, поэтому российские v6-сети
    исключить пушем нельзя — их просто не пушим: клиенты ходят к ним
    по нативному маршруту провайдера. source — откуда сеть (сервис/custom).
    """
    for ru in RUSSIA_V6_NETWORKS:
        if net.subnet_of(ru) or ru.subnet_of(net):
            origin = f" ({source})" if source else ""
            print(
                f"Пропуск {net.with_prefixlen}{origin} — пересекается с российской {ru}",
                file=sys.stderr,
            )
            return False
    VPN_V6_NETWORKS.add(net)
    return True


def fetch_antifilter():
    """Скачать список CIDR из antifilter и добавить сети в VPN-набор."""
    with urllib.request.urlopen(ANTIFILTER_URL, timeout=30) as resp:
        for raw in resp:
            cidr = raw.decode().strip()
            if not cidr or cidr.startswith("#"):
                continue
            try:
                net = ipaddress.ip_network(cidr, strict=False)
            except ValueError:
                continue
            if net.version != 4:
                continue
            add_v4(net, source="antifilter")


def fetch_iplist_services():
    """Скачать сети сервисов с iplist.opencck.org батчами и добавить в наборы.

    Сервисы разбиваются на батчи по IPLIST_BATCH_SIZE штук и запрашиваются
    одним HTTP-запросом каждый (?format=json&site=a&site=b&...).
    Упавший батч пропускается с warning — остальные обновляются.
    """
    services = list(IPLIST_SERVICES)
    for i in range(0, len(services), IPLIST_BATCH_SIZE):
        batch = services[i : i + IPLIST_BATCH_SIZE]
        url = IPLIST_BASE_URL + "/?" + urllib.parse.urlencode(
            {"format": "json", "site": batch}, doseq=True
        )
        try:
            with urllib.request.urlopen(url, timeout=60) as resp:
                data = json.loads(resp.read().decode())
        except Exception as e:
            print(
                f"Warning: не удалось скачать батч {batch[0]}..{batch[-1]}: {e}",
                file=sys.stderr,
            )
            continue
        for service in batch:
            entry = data.get(service)
            if not isinstance(entry, dict):
                print(f"Warning: сервис {service} отсутствует в ответе", file=sys.stderr)
                continue
            for cidr in entry.get("cidr4", []):
                try:
                    net = ipaddress.ip_network(cidr, strict=False)
                except ValueError:
                    continue
                if net.version != 4:
                    continue
                add_v4(net, source=service)
            if IPV6_ENABLED:
                # IPv6-сети сервисов — из того же ответа, без доп. запросов
                for cidr in entry.get("cidr6", []):
                    try:
                        net = ipaddress.ip_network(cidr, strict=False)
                    except ValueError:
                        continue
                    if net.version != 6:
                        continue
                    add_v6(net, service)
                if IPLIST_INCLUDE_IP6:
                    for ip in entry.get("ip6", []):
                        try:
                            net = ipaddress.ip_network(f"{ip}/128", strict=False)
                        except ValueError:
                            continue
                        add_v6(net, service)
            if IPLIST_INCLUDE_IP4:
                for ip in entry.get("ip4", []):
                    try:
                        net = ipaddress.ip_network(f"{ip}/32", strict=False)
                    except ValueError:
                        continue
                    add_v4(net, source=service)
        print(f"Загружен батч {batch[0]}..{batch[-1]} ({len(batch)} сервисов).")


def fetch_russia(batch_size, data_kind, sink):
    """Скачать сети выбранных российских порталов батчами.

    Порталы (openvpn_russia_exclude_portals) запрашиваются по
    IPLIST_BATCH_SIZE штук за запрос (?format=json&data=<cidr4|cidr6>&site=..)
    — как сервисы iplist, тем же порталом. sink(net) получает каждую сеть.
    Ошибка загрузки прерывает обновление: неполный российский список
    нарушил бы инвариант «российский трафик никогда через VPN».
    """
    for i in range(0, len(RUSSIA_PORTALS), batch_size):
        batch = RUSSIA_PORTALS[i : i + batch_size]
        url = RUSSIA_BASE_URL + "/?" + urllib.parse.urlencode(
            {"format": "json", "data": data_kind, "site": batch}, doseq=True
        )
        with urllib.request.urlopen(url, timeout=60) as resp:
            data = json.loads(resp.read().decode())
        for portal, cidrs in data.items():
            if not isinstance(cidrs, list):
                continue
            for cidr in cidrs:
                try:
                    net = ipaddress.ip_network(cidr, strict=False)
                except ValueError:
                    continue
                sink(portal, net)
        print(
            f"Загружен российский батч {batch[0]}..{batch[-1]} "
            f"({len(batch)} порталов, {data_kind})."
        )


def fetch_russia_exclude():
    """Скачать российские IPv4-сети в RU_V4_NETWORKS (net_gateway-набор).

    Эти сети попадают в routes-ru.inc, который включается только в CCD
    mobile-клиентов (redirect-gateway); роутеры его не получают.
    Из VPN-набора российские части вырезаются отдельно (cut_russian_v4).
    """

    def sink(portal, net):
        if net.version != 4:
            return
        add_v4(net, gateway="net_gateway")
        RU_V4_PORTALS.setdefault(net, set()).add(portal)

    fetch_russia(IPLIST_BATCH_SIZE, "cidr4", sink)


def prepare_ru_index():
    """Построить индекс российских сетей: collapse + сортировка по началу.

    Смежные российские сети сливаются (обе российские — объединение
    корректно), порталы-источники объединяются для логов. После collapse
    сети не пересекаются и не соприкасаются, а CIDR-блоки либо вкладываются,
    либо не пересекаются — поэтому контейнер и внутренние сети ищутся
    бисекцией за O(log n), без полного перебора по всем российским сетям.
    """
    global RU_SORTED, RU_STARTS, RU_COLLAPSED
    RU_SORTED = sorted(
        ipaddress.collapse_addresses(RU_V4_NETWORKS),
        key=lambda n: int(n.network_address),
    )
    RU_STARTS = [int(n.network_address) for n in RU_SORTED]
    RU_COLLAPSED = set(RU_SORTED)
    # порталы исходных (несхлопнутых) сетей переносим на схлопнутые
    for ru in RU_V4_NETWORKS:
        i = bisect.bisect_right(RU_STARTS, int(ru.network_address)) - 1
        if i >= 0 and int(RU_SORTED[i].broadcast_address) >= int(ru.broadcast_address):
            RU_V4_PORTALS.setdefault(RU_SORTED[i], set()).update(
                RU_V4_PORTALS.get(ru, set())
            )


def ru_containing(net):
    """Российская схема, содержащая net (или None)."""
    i = bisect.bisect_right(RU_STARTS, int(net.network_address)) - 1
    if i >= 0 and int(RU_SORTED[i].broadcast_address) >= int(net.broadcast_address):
        return RU_SORTED[i]
    return None


def ru_inside(net):
    """Российские сети строго внутри net (бисекцией, без полного перебора)."""
    lo = bisect.bisect_left(RU_STARTS, int(net.network_address))
    hi = bisect.bisect_right(RU_STARTS, int(net.broadcast_address))
    return [RU_SORTED[i] for i in range(lo, hi)]


def cut_russian_v4(nets):
    """Вырезать российские сети из VPN-сетей (v4) и вернуть оставшиеся куски.

    Вызывается ДО агрегации, по каждой сети отдельно: сеть, поглощённая при
    агрегации более широкой (например, 95.100.48.0/20 viber.com внутри
    95.100.0.0/15 facebook.com), не должна делить судьбу поглотителя —
    если он выкинут как российский, явная сеть всё равно пушится
    (у неё префикс длиннее).

    Российский трафик никогда не должен ходить через VPN:
    - точное совпадение с российской (исходной или схлопнутой) — сеть
      не пушится вовсе;
    - российская строго внутри — сеть режется на префиксы без российской
      части (ipaddress.address_exclude, итеративно для нескольких);
    - VPN строго внутри российской — пушится как есть (у неё префикс
      длиннее, остальная часть российской пойдёт по дефолту).
    Все случаи логируются в stderr.
    """
    result = set()
    for net in nets:
        if net in RU_V4_NETWORKS or net in RU_COLLAPSED:
            print(
                f"VPN-сеть {fmt_vpn(net)} точно совпадает с российской "
                f"{fmt_ru(net)} — не пушится",
                file=sys.stderr,
            )
            continue
        container = ru_containing(net)
        if container is not None:
            print(
                f"VPN {fmt_vpn(net)} внутри российской {fmt_ru(container)} "
                f"— пушится, у VPN префикс длиннее",
                file=sys.stderr,
            )
            result.add(net)
            continue
        pieces = [net]
        again = True
        while again:
            again = False
            new_pieces = []
            for piece in pieces:
                if piece in RU_V4_NETWORKS or piece in RU_COLLAPSED:
                    # кусок совпал с российской сетью (возможно, после разрезания)
                    print(
                        f"Кусок {fmt_vpn(piece)} совпал с российской "
                        f"{fmt_ru(piece)} — не пушится",
                        file=sys.stderr,
                    )
                    continue
                inner = ru_inside(piece)
                if inner:
                    print(
                        f"Российская {fmt_ru(inner[0])} вырезана из VPN "
                        f"{fmt_vpn(piece)}",
                        file=sys.stderr,
                    )
                    new_pieces.extend(piece.address_exclude(inner[0]))
                    again = True
                else:
                    new_pieces.append(piece)
            pieces = new_pieces
        result.update(pieces)
    return result


def fetch_russia_exclude_v6():
    """Скачать российские IPv6-сети в RUSSIA_V6_NETWORKS (фильтр v6-маршрутов)."""

    def sink(portal, net):
        if net.version == 6:
            RUSSIA_V6_NETWORKS.add(net)

    fetch_russia(IPLIST_BATCH_SIZE, "cidr6", sink)


def parse_custom():
    """Разобрать routes_custom.lst и добавить сети в наборы."""
    if not os.path.exists(CUSTOM_LIST):
        return
    with open(CUSTOM_LIST) as f:
        for raw in f:
            entry = raw.strip()
            if not entry or entry.startswith("#"):
                continue
            if "/" in entry:
                parts = entry.split("/")
                if len(parts) != 2:
                    continue
                ip_str, suffix = parts
                # IPv6 CIDR: 2a00:1450:4000::/37
                try:
                    net6 = ipaddress.ip_network(entry, strict=False)
                except ValueError:
                    net6 = None
                if net6 is not None and net6.version == 6:
                    if IPV6_ENABLED:
                        add_v6(net6, "routes_custom.lst")
                    continue
                try:
                    ipaddress.IPv4Address(ip_str)
                except ValueError:
                    continue
                # CIDR (149.154.164.0/22) или netmask (149.154.164.0/255.255.252.0)
                try:
                    add_v4(ipaddress.ip_network(entry, strict=False), source="routes_custom.lst")
                except ValueError:
                    continue
            else:
                # Hostname — резолвим в IPv4
                try:
                    infos = socket.getaddrinfo(entry, None, socket.AF_INET)
                except socket.gaierror:
                    print(f"Не удалось отрезолвить {entry}", file=sys.stderr)
                    continue
                for info in set(infos):
                    ip = info[4][0]
                    add_v4(ipaddress.ip_network(f"{ip}/32", strict=False), source="routes_custom.lst")


def build_lines():
    """Агрегировать сети, вырезать российские части и сгенерировать push-строки.

    Порядок (v4): вырезание российских (cut_russian_v4) по КАЖДОЙ сети
    отдельно -> финальная агрегация (collapse; куски от разных сетей могут
    стать смежными). Резать до агрегации обязательно: при агрегации узкая
    сеть исчезает внутри более широкой (95.100.48.0/20 viber.com внутри
    95.100.0.0/15 facebook.com, 1.1.1.0/24 из routes_custom.lst внутри
    1.0.0.0/9 whatsapp.com) и молча делит судьбу поглотителя при вырезании.
    Возвращает (vpn_lines, ru_lines): VPN-маршруты для routes.inc
    (включается в server.conf), российские net_gateway-маршруты для
    routes-ru.inc (включается только в CCD mobile-клиентов).
    """
    if RU_V4_NETWORKS:
        prepare_ru_index()
        vpn4_cut = cut_russian_v4(VPN_V4_NETWORKS)
    else:
        vpn4_cut = set(VPN_V4_NETWORKS)
    vpn4 = list(ipaddress.collapse_addresses(vpn4_cut))
    vpn6 = (
        list(ipaddress.collapse_addresses(VPN_V6_NETWORKS)) if IPV6_ENABLED else []
    )
    ru4 = list(ipaddress.collapse_addresses(RU_V4_NETWORKS))
    print(
        f"Агрегация: VPN v4 {len(VPN_V4_NETWORKS)} -> {len(vpn4_cut)} "
        f"(после вырезания российских) -> {len(vpn4)} (агрегация), "
        f"VPN v6 {len(VPN_V6_NETWORKS)} -> {len(vpn6)}, "
        f"российские net_gateway: {len(ru4)}."
    )

    lines = set()
    for net in vpn4:
        lines.add(f'push "route {net.network_address} {net.netmask} vpn_gateway"')
    for net in vpn6:
        lines.add(f'push "route-ipv6 {net.with_prefixlen}"')
    ru_lines = set()
    for net in ru4:
        ru_lines.add(f'push "route {net.network_address} {net.netmask} net_gateway"')
    return lines, ru_lines


def main():
    # Российские v6-сети — до всех v6-источников (нужен фильтр RUSSIA_V6_NETWORKS)
    if IPV6_ENABLED and RUSSIA_EXCLUDE_ENABLED and RUSSIA_PORTALS:
        try:
            fetch_russia_exclude_v6()
        except Exception as e:
            print(f"Ошибка загрузки российских v6-сетей: {e}", file=sys.stderr)
            sys.exit(1)
        print(f"Российских v6-сетей для фильтра: {len(RUSSIA_V6_NETWORKS)}.")

    if IPLIST_SERVICES:
        fetch_iplist_services()
    else:
        print("Сервисы iplist не заданы (openvpn_iplist_services=[]).")

    if ANTIFILTER_ENABLED:
        try:
            fetch_antifilter()
        except Exception as e:
            print(f"Ошибка загрузки antifilter: {e}", file=sys.stderr)
            sys.exit(1)
    else:
        print("antifilter отключён (openvpn_antifilter_enabled=false).")

    parse_custom()

    # Российские сети — после всех VPN-источников (нужен VPN_V4_NETWORKS)
    if RUSSIA_EXCLUDE_ENABLED and RUSSIA_PORTALS:
        try:
            fetch_russia_exclude()
        except Exception as e:
            print(f"Ошибка загрузки российских сетей: {e}", file=sys.stderr)
            sys.exit(1)
    elif RUSSIA_EXCLUDE_ENABLED:
        print(
            "ВНИМАНИЕ: порталы российских исключений не заданы "
            "(openvpn_russia_exclude_portals=[]) — из VPN-маршрутов ничего "
            "не вырезается, routes-ru.inc пуст.",
            file=sys.stderr,
        )
    else:
        print("Исключение российских сетей отключено (openvpn_russia_exclude_enabled=false).")

    routes, ru_routes = build_lines()

    header = "# Сгенерировано update_openvpn_routes.py — не редактируйте вручную\n"

    def write_inc(path, lines):
        """Атомарно записать файл, если содержимое изменилось; True — если изменился."""
        body = "\n".join(sorted(lines)) + "\n" if lines else ""
        new_content = header + body
        old_content = ""
        if os.path.exists(path):
            with open(path) as f:
                old_content = f.read()
        if new_content == old_content:
            return False
        with tempfile.NamedTemporaryFile(
            "w", dir=os.path.dirname(path), delete=False
        ) as tmp:
            tmp.write(new_content)
            tmp_path = tmp.name
        os.chmod(tmp_path, 0o640)
        os.rename(tmp_path, path)
        return True

    changed = write_inc(ROUTES_INC, routes)
    changed_ru = write_inc(ROUTES_RU_INC, ru_routes)
    if not (changed or changed_ru):
        print("Маршруты не изменились.")
        return
    if changed:
        print(f"routes.inc обновлён ({len(routes)} маршрутов).")
    if changed_ru:
        print(
            f"routes-ru.inc обновлён ({len(ru_routes)} российских "
            f"net_gateway-маршрутов)."
        )
    print("Рестарт openvpn.")
    subprocess.run(["systemctl", "restart", OPENVPN_SERVICE], check=True)


if __name__ == "__main__":
    main()
